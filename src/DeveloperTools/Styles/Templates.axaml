<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:DeveloperTools.ViewModels">

    <!-- One generated value with a copy button (passwords, keys, UUIDs). -->
    <DataTemplate x:Key="ValueRow" DataType="vm:CopyableValue">
        <Border Classes="result">
            <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Classes="value" Text="{Binding Display}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="btn ghost icon" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding CopyCommand}" ToolTip.Tip="Copy">
                    <Panel>
                        <PathIcon Data="{StaticResource Icon.Copy}" IsVisible="{Binding IsNotCopied}" />
                        <PathIcon Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Success}" IsVisible="{Binding IsCopied}" />
                    </Panel>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A labelled output value with an optional note (encoders, hashes, JWT parts). -->
    <DataTemplate x:Key="LabeledValueRow" DataType="vm:CopyableValue">
        <Border Classes="result" Padding="16,12,10,12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Text="{Binding Label}" Margin="0,0,0,6" />
                <SelectableTextBlock Grid.Row="1" Classes="value" Text="{Binding Display}" />
                <TextBlock Grid.Row="2" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                           FontSize="12" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button Grid.Column="1" Grid.RowSpan="3" Classes="btn ghost icon" Margin="8,-4,0,0" VerticalAlignment="Top"
                        Command="{Binding CopyCommand}" ToolTip.Tip="Copy">
                    <Panel>
                        <PathIcon Data="{StaticResource Icon.Copy}" IsVisible="{Binding IsNotCopied}" />
                        <PathIcon Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Success}" IsVisible="{Binding IsCopied}" />
                    </Panel>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
