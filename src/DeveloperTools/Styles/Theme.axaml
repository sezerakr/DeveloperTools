            <SolidColorBrush x:Key="Code.Inline" Color="#F0F0F2" />
            <SolidColorBrush x:Key="Code.InlineFg" Color="#27272A" />
            <SolidColorBrush x:Key="Mark.Bg" Color="#FEF08A" />
            <SolidColorBrush x:Key="Selection" Color="#4D71717A" />
            <SolidColorBrush x:Key="Editor.CurrentLine" Color="#F7F7F8" />

