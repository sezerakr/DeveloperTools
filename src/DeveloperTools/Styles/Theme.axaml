            <SolidColorBrush x:Key="Search.Bg" Color="#FDE68A" />
            <SolidColorBrush x:Key="Search.Marker" Color="#EAB308" />
            <SolidColorBrush x:Key="Search.MarkerCurrent" Color="#EA580C" />
