            <SolidColorBrush x:Key="Syntax.Attribute" Color="#0550AE" />

            <!-- header quick switch shows the mode you would switch to -->
            <StreamGeometry x:Key="Icon.ThemeToggle">M2,12A10,10 0 0,0 15,21.54A10,10 0 0,1 15,2.46A10,10 0 0,0 2,12Z</StreamGeometry>
