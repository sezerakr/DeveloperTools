            <SolidColorBrush x:Key="Diff.Removed" Color="#DC2626" />
            <SolidColorBrush x:Key="Diff.Modified" Color="#2563EB" />
            <SolidColorBrush x:Key="Diff.Viewport" Color="#2E18181B" />
