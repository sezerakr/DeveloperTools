<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Neutral (zinc-based) palette. Monochrome UI chrome; blue is used only for links.
        Dark mode layers from near-black (app) to dark gray (surfaces, hover, borders).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Bg.App" Color="#F4F4F5" />
            <SolidColorBrush x:Key="Bg.Sidebar" Color="#FAFAFA" />
            <SolidColorBrush x:Key="Bg.Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Bg.Subtle" Color="#F7F7F8" />
            <SolidColorBrush x:Key="Bg.Stripe" Color="#FBFBFB" />
            <SolidColorBrush x:Key="Bg.Hover" Color="#F0F0F1" />
            <SolidColorBrush x:Key="Bg.Pressed" Color="#E4E4E7" />
            <SolidColorBrush x:Key="Bg.Selected" Color="#E9E9EC" />
            <SolidColorBrush x:Key="Line" Color="#E4E4E7" />
            <SolidColorBrush x:Key="Line.Strong" Color="#D4D4D8" />
            <SolidColorBrush x:Key="Fg.Primary" Color="#18181B" />
            <SolidColorBrush x:Key="Fg.Secondary" Color="#52525B" />
            <SolidColorBrush x:Key="Fg.Muted" Color="#8B8B94" />
            <SolidColorBrush x:Key="Accent" Color="#18181B" />
            <SolidColorBrush x:Key="Accent.Hover" Color="#3F3F46" />
            <SolidColorBrush x:Key="Accent.Fg" Color="#FAFAFA" />
            <SolidColorBrush x:Key="Link" Color="#2563EB" />
            <SolidColorBrush x:Key="Danger" Color="#DC2626" />
            <SolidColorBrush x:Key="Danger.Hover" Color="#B91C1C" />
            <SolidColorBrush x:Key="Warning" Color="#B45309" />
            <SolidColorBrush x:Key="Warning.Bg" Color="#FEF3C7" />
            <SolidColorBrush x:Key="Dirty" Color="#D97706" />
            <SolidColorBrush x:Key="Success" Color="#15803D" />
            <SolidColorBrush x:Key="Success.Bg" Color="#DCFCE7" />
            <SolidColorBrush x:Key="Danger.Bg" Color="#FEE2E2" />
            <SolidColorBrush x:Key="Error.Line" Color="#14DC2626" />
            <SolidColorBrush x:Key="Meter.Off" Color="#E4E4E7" />
            <SolidColorBrush x:Key="Diff.AddedBg" Color="#E9F9EE" />
            <SolidColorBrush x:Key="Diff.AddedStrong" Color="#A6EDBC" />
            <SolidColorBrush x:Key="Diff.RemovedBg" Color="#FDECEC" />
            <SolidColorBrush x:Key="Diff.RemovedStrong" Color="#F9BDBD" />
            <SolidColorBrush x:Key="Diff.Filler" Color="#FAFAFA" />
