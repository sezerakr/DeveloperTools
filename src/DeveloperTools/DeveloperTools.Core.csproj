<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared app: every tool, view and view model. Hosted by DeveloperTools.Desktop and DeveloperTools.Browser. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>DeveloperTools</RootNamespace>
    <AssemblyName>DeveloperTools.Core</AssemblyName>
    <Version>1.3.3</Version>
    <Product>DeveloperTools</Product>

    <!-- Compiled bindings everywhere: faster, and required for trimming / native AOT / WebAssembly. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent2" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
