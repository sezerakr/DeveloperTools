<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveloperTools.ViewModels"
             xmlns:c="using:DeveloperTools.Converters"
             x:Class="DeveloperTools.Views.GeneratorsPage"
             x:DataType="vm:GeneratorsPageViewModel">

    <UserControl.Styles>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox, TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Line}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16,12" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,0" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <RadioButton Classes="tab" GroupName="gen-tab" Content="Password"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Password}" />
                <RadioButton Classes="tab" GroupName="gen-tab" Content="Secret key"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Secret}" />
                <RadioButton Classes="tab" GroupName="gen-tab" Content="UUID"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Uuid}" />
                <RadioButton Classes="tab" GroupName="gen-tab" Content="Lorem ipsum"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Lorem}" />
                <RadioButton Classes="tab" GroupName="gen-tab" Content="Fake data"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Fake}" />
                <RadioButton Classes="tab" GroupName="gen-tab" Content="QR code"
                             IsChecked="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Qr}" />
            </WrapPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,40" MaxWidth="1100" Spacing="16">

                <!-- ============================================ PASSWORD -->
                <Grid x:Name="PasswordPane" Classes="twopane"
                      IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Password}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="field" Text="Length" />
                                    <TextBlock Grid.Column="1" Text="{Binding PasswordLength}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}" />
                                </Grid>
                                <Slider Minimum="4" Maximum="128" Value="{Binding PasswordLength}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,-4,0,-8" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Classes="field" Text="Characters" />
                                <CheckBox IsChecked="{Binding UseUpper}" Content="Uppercase  A–Z" />
                                <CheckBox IsChecked="{Binding UseLower}" Content="Lowercase  a–z" />
                                <CheckBox IsChecked="{Binding UseDigits}" Content="Digits  0–9" />
                                <CheckBox IsChecked="{Binding UseSymbols}" Content="Symbols  ! @ # $ % …" />
                                <CheckBox IsChecked="{Binding ExcludeAmbiguous}" Content="Avoid look-alikes  I l 1 O 0 o" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="How many" />
                                <NumericUpDown Value="{Binding PasswordCount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <Grid x:Name="Meter" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                                    <Border Grid.Column="0" Classes="meter" />
                                    <Border Grid.Column="1" Classes="meter" />
                                    <Border Grid.Column="2" Classes="meter" />
                                    <Border Grid.Column="3" Classes="meter" />
                                    <Border Grid.Column="4" Classes="meter" />
                                </Grid>
                                <TextBlock Text="{Binding StrengthText}" FontSize="12.5" Classes="secondary" />
                            </StackPanel>

                            <Button Classes="btn primary" HorizontalAlignment="Stretch" Command="{Binding GeneratePasswordsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Generate new" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="Passwords" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyAllPasswordsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy all" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <TextBlock Classes="error" Text="{Binding PasswordError}"
                                       IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding Passwords}" ItemTemplate="{StaticResource ValueRow}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================ SECRET KEY -->
                <Grid x:Name="SecretPane" Classes="twopane"
                      IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Secret}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <StackPanel>
                                <TextBlock Classes="field" Text="Presets" />
                                <WrapPanel>
                                    <Button Classes="btn xs" Margin="0,0,6,6" Content="API key" Command="{Binding ApplyPresetCommand}" CommandParameter="api"
                                            ToolTip.Tip="32 letters and digits" />
                                    <Button Classes="btn xs" Margin="0,0,6,6" Content="JWT secret" Command="{Binding ApplyPresetCommand}" CommandParameter="jwt"
                                            ToolTip.Tip="64 random bytes as Base64 (HS256/HS512)" />
                                    <Button Classes="btn xs" Margin="0,0,6,6" Content="AES-256" Command="{Binding ApplyPresetCommand}" CommandParameter="aes256"
                                            ToolTip.Tip="32 random bytes as hex" />
                                    <Button Classes="btn xs" Margin="0,0,6,6" Content="AES-128" Command="{Binding ApplyPresetCommand}" CommandParameter="aes128"
                                            ToolTip.Tip="16 random bytes as hex" />
                                    <Button Classes="btn xs" Margin="0,0,6,6" Content="URL token" Command="{Binding ApplyPresetCommand}" CommandParameter="token"
                                            ToolTip.Tip="32 random bytes, Base64 URL-safe" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="Format" />
                                <ComboBox ItemsSource="{Binding KeyFormats}" SelectedItem="{Binding KeyFormat}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsCustomFormat}">
                                <TextBlock Classes="field" Text="Characters to use" />
                                <TextBox Text="{Binding CustomChars}" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="{Binding KeySizeLabel}" />
                                <NumericUpDown Value="{Binding KeySize}" Minimum="1" Maximum="4096" Increment="1" FormatString="0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="Prefix (optional)" />
                                <TextBox Text="{Binding Prefix}" PlaceholderText="e.g. sk_live_" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="How many" />
                                <NumericUpDown Value="{Binding KeyCount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
                            </StackPanel>

                            <TextBlock Text="{Binding KeyInfo}" FontSize="12.5" Classes="secondary" />

                            <Button Classes="btn primary" HorizontalAlignment="Stretch" Command="{Binding GenerateSecretsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Generate new" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="Secret keys" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyAllSecretsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy all" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <TextBlock Classes="error" Text="{Binding KeyError}"
                                       IsVisible="{Binding KeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ItemsControl ItemsSource="{Binding Secrets}" ItemTemplate="{StaticResource ValueRow}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================ UUID -->
                <Grid x:Name="UuidPane" Classes="twopane"
                      IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Uuid}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <StackPanel>
                                <TextBlock Classes="field" Text="Version" />
                                <Border Classes="segmented" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Classes="segment" GroupName="uuid-version" Content="v4 · random" IsChecked="{Binding UuidVersion4}" />
                                        <RadioButton Classes="segment" GroupName="uuid-version" Content="v7 · time-ordered" IsChecked="{Binding UuidVersion7}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="v7 starts with a timestamp, so new IDs sort after older ones. Good for database keys." />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Classes="field" Text="Format" />
                                <CheckBox IsChecked="{Binding UuidHyphens}" Content="Hyphens" />
                                <CheckBox IsChecked="{Binding UuidUppercase}" Content="Uppercase" />
                                <CheckBox IsChecked="{Binding UuidBraces}" Content="Braces  { }" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="field" Text="How many" />
                                <NumericUpDown Value="{Binding UuidCount}" Minimum="1" Maximum="500" Increment="1" FormatString="0" />
                            </StackPanel>

                            <Button Classes="btn primary" HorizontalAlignment="Stretch" Command="{Binding GenerateUuidsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Generate new" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="UUIDs" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyAllUuidsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy all" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <ItemsControl ItemsSource="{Binding Uuids}" ItemTemplate="{StaticResource ValueRow}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================ LOREM -->
                <Grid x:Name="LoremPane" IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Lorem}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <StackPanel>
                                <TextBlock Classes="field" Text="Generate" />
                                <Border Classes="segmented" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Classes="segment" GroupName="lorem" Content="Paragraphs"
                                                     IsChecked="{Binding LoremUnit, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Paragraphs}" />
                                        <RadioButton Classes="segment" GroupName="lorem" Content="Sentences"
                                                     IsChecked="{Binding LoremUnit, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Sentences}" />
                                        <RadioButton Classes="segment" GroupName="lorem" Content="Words"
                                                     IsChecked="{Binding LoremUnit, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Words}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field" Text="How many" />
                                <NumericUpDown Value="{Binding LoremCount}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding LoremStart}" Content="Start with &quot;Lorem ipsum dolor sit amet&quot;" />
                            <Button Classes="btn primary" HorizontalAlignment="Stretch" Command="{Binding GenerateLoremCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Generate new" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="Text" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyLoremCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <SelectableTextBlock Text="{Binding LoremText}" TextWrapping="Wrap" FontSize="13.5" LineHeight="22"
                                                 Margin="16,12,16,16" Foreground="{DynamicResource Fg.Primary}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================ FAKE DATA -->
                <Grid x:Name="FakePane" IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Fake}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="field" Text="Fields" />
                                <ItemsControl ItemsSource="{Binding FakeFields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:FakeFieldOption">
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field" Text="Format" />
                                <ComboBox ItemsSource="{Binding FakeFormats}" SelectedItem="{Binding FakeFormat}" Width="150" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="field" Text="Rows" />
                                <NumericUpDown Value="{Binding FakeCount}" Minimum="1" Maximum="10000" Increment="1" FormatString="0" />
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="Clearly fake on purpose: example.com emails, +1 555-01xx phone numbers and documentation-only IP addresses. Safe to use in tests and demos." />
                            <Button Classes="btn primary" HorizontalAlignment="Stretch" Command="{Binding GenerateFakeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon.Refresh}" />
                                    <TextBlock Text="Generate new" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="Test data" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyFakeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Classes="value" Text="{Binding FakeOutput}" TextWrapping="NoWrap" FontSize="12.5"
                                                     Margin="16,12,16,16" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================ QR CODE -->
                <Grid x:Name="QrPane" IsVisible="{Binding Tab, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Qr}">
                    <Border Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="18">
                            <Border Classes="segmented" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="segment" GroupName="qrmode" Content="Text or link"
                                                 IsChecked="{Binding QrMode, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Text}" />
                                    <RadioButton Classes="segment" GroupName="qrmode" Content="Wi-Fi"
                                                 IsChecked="{Binding QrMode, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Wifi}" />
                                </StackPanel>
                            </Border>
                            <StackPanel IsVisible="{Binding IsQrText}">
                                <TextBlock Classes="field" Text="Content" />
                                <TextBox Text="{Binding QrText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" FontSize="13" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsQrWifi}" Spacing="12">
                                <StackPanel>
                                    <TextBlock Classes="field" Text="Network name (SSID)" />
                                    <TextBox Text="{Binding WifiSsid}" FontSize="13" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field" Text="Password" />
                                    <TextBox Text="{Binding WifiPassword}" PasswordChar="•" FontSize="13" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Classes="field" Text="Security" />
                                        <ComboBox ItemsSource="{Binding WifiSecurities}" SelectedItem="{Binding WifiSecurity}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Hidden network" IsChecked="{Binding WifiHidden}" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <StackPanel>
                                    <TextBlock Classes="field" Text="Error correction" />
                                    <ComboBox ItemsSource="{Binding EccLevels}" SelectedItem="{Binding QrEcc}" Width="90"
                                              ToolTip.Tip="Higher levels survive damage but make a denser code" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="field" Text="Size" />
                                    <Slider Minimum="4" Maximum="16" Value="{Binding QrScale}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Margin="0,-6,0,-8" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,10,10,10">
                                <TextBlock Classes="h3" Text="QR code" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="btn ghost" Command="{Binding CopyQrCommand}" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Copy}" />
                                        <TextBlock Text="Copy image" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="btn" Command="{Binding SaveQrCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource Icon.Save}" />
                                        <TextBlock Text="Save PNG" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Classes="divider" />
                            <Border Background="#FFFFFF" CornerRadius="8" Margin="16" Padding="12" HorizontalAlignment="Center"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <Image Source="{Binding QrImage}" MaxWidth="360" MaxHeight="360" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="None" />
                            </Border>
                            <TextBlock Text="{Binding QrInfo}" FontSize="12" Classes="muted" HorizontalAlignment="Center" Margin="16,0,16,16"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"                           Text="Values come from the operating system's cryptographic random generator. Nothing is stored or sent anywhere." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
