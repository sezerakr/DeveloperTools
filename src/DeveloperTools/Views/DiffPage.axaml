<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DeveloperTools.Localization"
             xmlns:vm="using:DeveloperTools.ViewModels"
             xmlns:c="using:DeveloperTools.Converters"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:views="using:DeveloperTools.Views"
             x:Class="DeveloperTools.Views.DiffPage"
             x:DataType="vm:DiffPageViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding CompareCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding NextChangeCommand}" />
        <KeyBinding Gesture="Shift+F7" Command="{Binding PreviousChangeCommand}" />
        <KeyBinding Gesture="Alt+Down" Command="{Binding NextChangeCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding PreviousChangeCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Border.pane-head">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.stat > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <Border Classes="segmented" Margin="0,2,10,2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="segment" GroupName="diffview" Content="{l:T 'Edit'}"
                                     IsChecked="{Binding View, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Edit}" />
                        <RadioButton Classes="segment" GroupName="diffview" Content="{l:T 'Side by side'}"
                                     IsChecked="{Binding View, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=SideBySide}" />
                        <RadioButton Classes="segment" GroupName="diffview" Content="{l:T 'Inline'}"
                                     IsChecked="{Binding View, Converter={x:Static c:EnumEquals.Instance}, ConverterParameter=Inline}" />
                    </StackPanel>
                </Border>

                <Button Classes="btn primary" Margin="0,2,10,2" Command="{Binding CompareCommand}" IsVisible="{Binding IsEditView}"
                        ToolTip.Tip="{l:T 'Compare (Ctrl+Enter)'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Diff}" />
                        <TextBlock Text="{l:T 'Compare'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- navigation + stats (result views) -->
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,10,2" IsVisible="{Binding IsResultView}">
                    <Button Classes="btn ghost icon" Command="{Binding PreviousChangeCommand}" ToolTip.Tip="{l:T 'Previous change (Shift+F7)'}">
                        <PathIcon Data="{StaticResource Icon.ChevronUp}" />
                    </Button>
                    <Button Classes="btn ghost icon" Command="{Binding NextChangeCommand}" ToolTip.Tip="{l:T 'Next change (F7)'}">
                        <PathIcon Data="{StaticResource Icon.ChevronDown}" />
                    </Button>
                    <TextBlock Text="{Binding ChangePosition}" FontSize="12.5" Classes="secondary" VerticalAlignment="Center"
                               Margin="6,0,10,0" MinWidth="64" />
                    <Border Classes="stat" Background="{DynamicResource Diff.AddedBg}" IsVisible="{Binding HasAdded}"
                            ToolTip.Tip="{l:T 'Added lines'}">
                        <TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource Diff.Added}" />
                    </Border>
                    <Border Classes="stat" Background="{DynamicResource Diff.RemovedBg}" IsVisible="{Binding HasRemoved}"
                            ToolTip.Tip="{l:T 'Removed lines'}">
                        <TextBlock Text="{Binding RemovedText}" Foreground="{DynamicResource Diff.Removed}" />
                    </Border>
                    <Border Classes="stat" Background="{DynamicResource Bg.Hover}" IsVisible="{Binding HasModified}"
                            ToolTip.Tip="{l:T 'Changed lines'}">
                        <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource Diff.Modified}" />
                    </Border>
                    <Border Classes="pill ok" IsVisible="{Binding IsIdentical}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource Icon.CheckCircle}" />
                            <TextBlock Text="{l:T 'Identical'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Classes="tool-sep" Margin="0,0,10,0" />
                <TextBlock Text="{l:T 'Ignore'}" FontSize="12.5" Classes="muted" VerticalAlignment="Center" Margin="0,2,8,2" />
                <CheckBox Content="{l:T 'Whitespace'}" IsChecked="{Binding IgnoreWhitespace}" Margin="0,2,12,2" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T 'Ignore differences in spaces, tabs and indentation'}" />
                <CheckBox Content="{l:T 'Case'}" IsChecked="{Binding IgnoreCase}" Margin="0,2,14,2" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T 'Ignore upper/lower case differences'}" />
                <CheckBox Content="{l:T 'JSON'}" IsChecked="{Binding CompareAsJson}" Margin="0,2,14,2" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T 'Format both sides and sort keys first, so only data changes show'}" />
                <CheckBox Content="{l:T 'Only changes'}" IsChecked="{Binding OnlyChanges}" Margin="0,2,10,2" VerticalAlignment="Center"
                          ToolTip.Tip="{l:T 'Fold unchanged lines, keeping 3 lines of context'}" />

                <Border Classes="tool-sep" Margin="0,0,10,0" />
                <Button Classes="btn ghost icon" Margin="0,2,2,2" Command="{Binding SwapCommand}" ToolTip.Tip="{l:T 'Swap sides'}">
                    <PathIcon Data="{StaticResource Icon.Swap}" />
                </Button>
                <Button Classes="btn ghost icon" Margin="0,2,2,2" Command="{Binding CopyPatchCommand}" IsVisible="{Binding IsResultView}"
                        ToolTip.Tip="{l:T 'Copy as a unified diff (patch)'}">
                    <PathIcon Data="{StaticResource Icon.Copy}" />
                </Button>
                <ProgressBar IsIndeterminate="True" Width="60" Height="3" MinWidth="0" Margin="8,0" VerticalAlignment="Center"
                             IsVisible="{Binding IsBusy}" />
            </WrapPanel>
        </Border>

        <!-- note strip -->
        <Border DockPanel.Dock="Top" Classes="notice" Background="{DynamicResource Bg.Subtle}" IsVisible="{Binding HasNote}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource Icon.Alert}" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top"
                          Foreground="{DynamicResource Fg.Muted}" />
                <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="btn ghost icon" Width="22" Height="22" Margin="10,-2,-4,-2"
                        Command="{Binding DismissNoteCommand}" VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>

        <Panel>
            <!-- ======================================== EDIT -->
            <Grid x:Name="EditGrid" IsVisible="{Binding IsEditView}" ColumnDefinitions="*,Auto,*">
                <DockPanel x:Name="LeftPane" Grid.Column="0">
                    <Border DockPanel.Dock="Top" Classes="pane-head">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Removed}" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LeftName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip.Tip="{Binding LeftPath}" />
                                <TextBlock Text="{Binding LeftStats}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Classes="btn ghost icon" Command="{Binding OpenLeftCommand}" ToolTip.Tip="{l:T 'Open file (or drop one here)'}">
                                    <PathIcon Data="{StaticResource Icon.FolderOpen}" />
                                </Button>
                                <Button Classes="btn ghost icon" Command="{Binding PasteLeftCommand}" ToolTip.Tip="{l:T 'Paste from clipboard'}">
                                    <PathIcon Data="{StaticResource Icon.Paste}" />
                                </Button>
                                <Button Classes="btn ghost icon" Command="{Binding ClearLeftCommand}" ToolTip.Tip="{l:T 'Clear'}">
                                    <PathIcon Data="{StaticResource Icon.Eraser}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ae:TextEditor x:Name="LeftEditor" Document="{Binding LeftDocument}" FontSize="{Binding EditorFontSize}"
                                   FontFamily="{StaticResource Font.Mono}" ShowLineNumbers="True" Padding="8,10,16,10"
                                   HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Bg.Surface}"
                                   Foreground="{DynamicResource Fg.Primary}" LineNumbersForeground="{DynamicResource Fg.Muted}" />
                </DockPanel>

                <Border x:Name="EditDivider" Grid.Column="1" Width="1" Background="{DynamicResource Line}" />

                <DockPanel x:Name="RightPane" Grid.Column="2">
                    <Border DockPanel.Dock="Top" Classes="pane-head">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Added}" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RightName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip.Tip="{Binding RightPath}" />
                                <TextBlock Text="{Binding RightStats}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Classes="btn ghost icon" Command="{Binding OpenRightCommand}" ToolTip.Tip="{l:T 'Open file (or drop one here)'}">
                                    <PathIcon Data="{StaticResource Icon.FolderOpen}" />
                                </Button>
                                <Button Classes="btn ghost icon" Command="{Binding PasteRightCommand}" ToolTip.Tip="{l:T 'Paste from clipboard'}">
                                    <PathIcon Data="{StaticResource Icon.Paste}" />
                                </Button>
                                <Button Classes="btn ghost icon" Command="{Binding ClearRightCommand}" ToolTip.Tip="{l:T 'Clear'}">
                                    <PathIcon Data="{StaticResource Icon.Eraser}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ae:TextEditor x:Name="RightEditor" Document="{Binding RightDocument}" FontSize="{Binding EditorFontSize}"
                                   FontFamily="{StaticResource Font.Mono}" ShowLineNumbers="True" Padding="8,10,16,10"
                                   HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Bg.Surface}"
                                   Foreground="{DynamicResource Fg.Primary}" LineNumbersForeground="{DynamicResource Fg.Muted}" />
                </DockPanel>
            </Grid>

            <!-- ======================================== SIDE BY SIDE -->
            <Grid IsVisible="{Binding IsSideBySide}" ColumnDefinitions="*,1,*,14" RowDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="pane-head">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Removed}" />
                        <TextBlock Text="{Binding LeftName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LeftPath}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Line.Strong}" />
                <Border Grid.Column="2" Grid.ColumnSpan="2" Classes="pane-head">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Added}" />
                        <TextBlock Text="{Binding RightName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RightPath}" />
                    </StackPanel>
                </Border>
                <ae:TextEditor x:Name="LeftView" Grid.Row="1" Grid.Column="0" IsReadOnly="True" FontSize="{Binding EditorFontSize}"
                               FontFamily="{StaticResource Font.Mono}" Padding="6,8,16,8" HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Hidden"
                               Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Fg.Primary}" />
                <ae:TextEditor x:Name="RightView" Grid.Row="1" Grid.Column="2" IsReadOnly="True" FontSize="{Binding EditorFontSize}"
                               FontFamily="{StaticResource Font.Mono}" Padding="6,8,16,8" HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Hidden"
                               Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Fg.Primary}" />
                <views:DiffOverview x:Name="SideOverview" Grid.Row="1" Grid.Column="3"
                                    ToolTip.Tip="{l:T 'Overview: click or drag to jump'}" />
            </Grid>

            <!-- ======================================== INLINE -->
            <Grid IsVisible="{Binding IsInline}" ColumnDefinitions="*,14" RowDefinitions="Auto,*">
                <Border Grid.ColumnSpan="2" Classes="pane-head">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Removed}" />
                        <TextBlock Text="{Binding LeftName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <PathIcon Data="{StaticResource Icon.Swap}" Width="12" Height="12" Foreground="{DynamicResource Fg.Muted}" Margin="4,0" />
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Diff.Added}" />
                        <TextBlock Text="{Binding RightName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                </Border>
                <ae:TextEditor x:Name="InlineView" Grid.Row="1" IsReadOnly="True" FontSize="{Binding EditorFontSize}"
                               FontFamily="{StaticResource Font.Mono}" Padding="6,8,16,8" HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Hidden"
                               Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Fg.Primary}" />
                <views:DiffOverview x:Name="InlineOverview" Grid.Row="1" Grid.Column="1"
                                    ToolTip.Tip="{l:T 'Overview: click or drag to jump'}" />
            </Grid>
        </Panel>
    </DockPanel>
</UserControl>
