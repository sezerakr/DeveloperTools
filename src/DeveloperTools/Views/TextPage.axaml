<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:DeveloperTools.Localization"
             xmlns:vm="using:DeveloperTools.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:views="using:DeveloperTools.Views"
             x:Class="DeveloperTools.Views.TextPage"
             x:DataType="vm:TextPageViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel VerticalAlignment="Center">
                    <Button Classes="btn" Margin="0,2,6,2" ToolTip.Tip="{l:T 'Change the case of the selection (or all text)'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Text}" />
                            <TextBlock Text="{l:T 'Case'}" VerticalAlignment="Center" />
                            <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{l:T 'camelCase'}" Command="{Binding CaseCommand}" CommandParameter="Camel" />
                                <MenuItem Header="{l:T 'PascalCase'}" Command="{Binding CaseCommand}" CommandParameter="Pascal" />
                                <MenuItem Header="{l:T 'snake_case'}" Command="{Binding CaseCommand}" CommandParameter="Snake" />
                                <MenuItem Header="{l:T 'kebab-case'}" Command="{Binding CaseCommand}" CommandParameter="Kebab" />
                                <MenuItem Header="{l:T 'CONSTANT_CASE'}" Command="{Binding CaseCommand}" CommandParameter="Constant" />
                                <MenuItem Header="{l:T 'dot.case'}" Command="{Binding CaseCommand}" CommandParameter="Dot" />
                                <Separator />
                                <MenuItem Header="{l:T 'Title Case'}" Command="{Binding CaseCommand}" CommandParameter="Title" />
                                <MenuItem Header="{l:T 'Sentence case'}" Command="{Binding CaseCommand}" CommandParameter="Sentence" />
                                <MenuItem Header="{l:T 'UPPERCASE'}" Command="{Binding CaseCommand}" CommandParameter="Upper" />
                                <MenuItem Header="{l:T 'lowercase'}" Command="{Binding CaseCommand}" CommandParameter="Lower" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="btn" Margin="0,2,6,2" ToolTip.Tip="{l:T 'Line operations on the selection (or all text)'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.ListBullet}" />
                            <TextBlock Text="{l:T 'Lines'}" VerticalAlignment="Center" />
                            <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{l:T 'Sort A → Z'}" Command="{Binding LinesCommand}" CommandParameter="sort" />
                                <MenuItem Header="{l:T 'Sort Z → A'}" Command="{Binding LinesCommand}" CommandParameter="sortdesc" />
                                <MenuItem Header="{l:T 'Reverse order'}" Command="{Binding LinesCommand}" CommandParameter="reverse" />
                                <MenuItem Header="{l:T 'Shuffle'}" Command="{Binding LinesCommand}" CommandParameter="shuffle" />
                                <Separator />
                                <MenuItem Header="{l:T 'Remove duplicates'}" Command="{Binding LinesCommand}" CommandParameter="unique" />
                                <MenuItem Header="{l:T 'Remove duplicates (ignore case)'}" Command="{Binding LinesCommand}" CommandParameter="uniquei" />
                                <MenuItem Header="{l:T 'Remove empty lines'}" Command="{Binding LinesCommand}" CommandParameter="empty" />
                                <MenuItem Header="{l:T 'Trim spaces'}" Command="{Binding LinesCommand}" CommandParameter="trim" />
                                <MenuItem Header="{l:T 'Number lines'}" Command="{Binding LinesCommand}" CommandParameter="number" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Border Classes="tool-sep" Margin="4,0,10,0" />
                    <TextBlock Text="{l:T 'Separator'}" FontSize="12.5" Classes="muted" VerticalAlignment="Center" Margin="0,2,8,2" />
                    <TextBox Text="{Binding Separator}" Width="70" FontFamily="{StaticResource Font.Mono}" FontSize="13"
                             Margin="0,2,6,2" ToolTip.Tip="Used by Join and Split. \n means newline, \t tab." />
                    <Button Classes="btn" Margin="0,2,6,2" Content="{l:T 'Join lines'}" Command="{Binding LinesCommand}" CommandParameter="join" />
                    <Button Classes="btn" Margin="0,2,6,2" Content="{l:T 'Split to lines'}" Command="{Binding LinesCommand}" CommandParameter="split" />
                    <Border Classes="tool-sep" Margin="4,0,10,0" />
                    <CheckBox Content="{l:T 'Wrap'}" IsChecked="{Binding WordWrap}" Margin="0,2,6,2" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="8,2,0,2">
                    <views:SnippetsButton DataContext="{Binding Snippets}" />
                    <Button Classes="btn ghost icon" Command="{Binding CopyAllCommand}" ToolTip.Tip="{l:T 'Copy all'}">
                        <PathIcon Data="{StaticResource Icon.Copy}" />
                    </Button>
                    <Button Classes="btn ghost icon" Command="{Binding ClearCommand}" ToolTip.Tip="{l:T 'Clear'}">
                        <PathIcon Data="{StaticResource Icon.Eraser}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" MinHeight="30" Padding="14,6" Background="{DynamicResource Bg.Subtle}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Stats}" FontSize="12" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectionStats}" FontSize="12" Classes="muted"
                           IsVisible="{Binding SelectionStats, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <Panel>
            <ae:TextEditor x:Name="Editor" Document="{Binding Document}" FontSize="{Binding EditorFontSize}"
                           WordWrap="{Binding WordWrap}" FontFamily="{StaticResource Font.Mono}" ShowLineNumbers="True"
                           Padding="8,12,16,12" HorizontalScrollBarVisibility="Auto"
                           Background="{DynamicResource Bg.Surface}" Foreground="{DynamicResource Fg.Primary}"
                           LineNumbersForeground="{DynamicResource Fg.Muted}" />
            <TextBlock Text="{l:T 'Paste or type text. Case and line tools work on the selection, or on everything when nothing is selected.'}"
                       IsHitTestVisible="False" Classes="muted" FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
        </Panel>
    </DockPanel>
</UserControl>
