<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeveloperTools.ViewModels"
        xmlns:views="using:DeveloperTools.Views"
        x:Class="DeveloperTools.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeveloperTools"
        Icon="avares://DeveloperTools.Core/Assets/app.ico"
        Width="1360" Height="860"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.App}">
    <views:MainView x:Name="View" />
</Window>
