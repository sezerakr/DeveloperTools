<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DeveloperTools.ViewModels"
        xmlns:views="using:DeveloperTools.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="DeveloperTools.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeveloperTools"
        Icon="avares://DeveloperTools/Assets/app.ico"
        Width="1360" Height="860"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.App}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenPaletteCommand}" />
    </Window.KeyBindings>

    <Panel>
    <Grid x:Name="RootGrid" ColumnDefinitions="224,*">

        <!-- ================================================= sidebar -->
        <Border x:Name="Sidebar" Grid.Column="0" Classes="sidebar"
                Background="{DynamicResource Bg.Sidebar}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="56" Padding="12,0"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Classes="wide" Text="DeveloperTools" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="SidebarToggle" Grid.Column="1" Classes="btn ghost icon"
                                Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle sidebar">
                            <PathIcon Data="{StaticResource Icon.Menu}" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,14" Spacing="2">
                    <Button Classes="nav" Classes.active="{Binding IsSettingsActive}" Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Settings}" />
                            <TextBlock Classes="wide" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="muted wide" Text="{Binding Version}" FontSize="11" Margin="10,10,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,12,10,0" Spacing="2">
                    <!-- command palette launcher -->
                    <Button x:Name="SearchButton" Classes="nav" Command="{Binding OpenPaletteCommand}" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" ToolTip.Tip="Search tools and actions (Ctrl+K)">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Data="{StaticResource Icon.Search}" Width="15" Height="15" Foreground="{DynamicResource Fg.Muted}" />
                            <TextBlock Grid.Column="1" Classes="wide muted" Text="Search…" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontWeight="Normal" />
                            <Border Grid.Column="2" Classes="wide" CornerRadius="4" Padding="5,1" Background="{DynamicResource Bg.Pressed}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" FontSize="10.5" Classes="muted" />
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Classes="label wide" Text="TOOLS" Margin="10,0,0,8" />
                    <Button Classes="nav" Classes.active="{Binding IsMarkdownActive}" Command="{Binding ShowMarkdownCommand}" ToolTip.Tip="Markdown">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Markdown}" />
                            <TextBlock Classes="wide" Text="Markdown" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsJsonActive}" Command="{Binding ShowJsonCommand}" ToolTip.Tip="JSON">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Json}" />
                            <TextBlock Classes="wide" Text="JSON" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsDiffActive}" Command="{Binding ShowDiffCommand}" ToolTip.Tip="Diff">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Diff}" />
                            <TextBlock Classes="wide" Text="Diff" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsRegexActive}" Command="{Binding ShowRegexCommand}" ToolTip.Tip="Regex">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Regex}" />
                            <TextBlock Classes="wide" Text="Regex" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsTimestampActive}" Command="{Binding ShowTimestampCommand}" ToolTip.Tip="Timestamp">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Clock}" />
                            <TextBlock Classes="wide" Text="Timestamp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsTextActive}" Command="{Binding ShowTextCommand}" ToolTip.Tip="Text">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Text}" />
                            <TextBlock Classes="wide" Text="Text" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsGeneratorsActive}" Command="{Binding ShowGeneratorsCommand}" ToolTip.Tip="Generators">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Generate}" />
                            <TextBlock Classes="wide" Text="Generators" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsEncodeActive}" Command="{Binding ShowEncodeCommand}" ToolTip.Tip="Encode / Decode">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.Swap}" />
                            <TextBlock Classes="wide" Text="Encode / Decode" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================================= content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="56" Padding="24,0"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding CurrentPage.Title}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="1" Height="16" Margin="12,0"
                            Background="{DynamicResource Line.Strong}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentPage.Subtitle}" FontSize="13" Classes="muted"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Classes="btn ghost icon" Margin="12,0,-8,0"
                            Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Switch light / dark">
                        <PathIcon Data="{DynamicResource Icon.ThemeToggle}" />
                    </Button>
                </Grid>
            </Border>

            <!-- clipboard suggestion -->
            <Border DockPanel.Dock="Top" Padding="16,7" Background="{DynamicResource Bg.Subtle}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" IsVisible="{Binding HasClipboardHint}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <PathIcon Data="{StaticResource Icon.Paste}" Width="14" Height="14" Margin="0,0,10,0"
                              Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ClipboardHint}" FontSize="12.5" Classes="secondary"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="btn xs primary" Content="{Binding ClipboardAction}" Margin="10,0,4,0"
                            Command="{Binding UseClipboardCommand}" />
                    <Button Grid.Column="3" Classes="btn ghost icon" Width="24" Height="24" Command="{Binding DismissClipboardCommand}"
                            ToolTip.Tip="Dismiss (turn off in Settings → General)">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <views:PageHost Page="{Binding CurrentPage}" />
        </DockPanel>
    </Grid>

    <!-- ================================================= command palette -->
    <Border x:Name="PaletteOverlay" IsVisible="{Binding IsPaletteOpen}" Background="#66000000"
            PointerPressed="OnOverlayPressed">
        <Border x:Name="PaletteCard" Classes="card" Width="600" MaxWidth="600" Margin="16,90,16,16"
                HorizontalAlignment="Center" VerticalAlignment="Top" BoxShadow="0 12 40 0 #40000000"
                PointerPressed="OnPaletteCardPressed">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="14,4,10,4">
                    <PathIcon Data="{StaticResource Icon.Search}" Width="16" Height="16" Foreground="{DynamicResource Fg.Muted}" />
                    <TextBox x:Name="PaletteBox" Grid.Column="1" Text="{Binding PaletteQuery}" Classes="bare"
                             PlaceholderText="Search tools and actions…" FontSize="15" Padding="10,10" />
                    <Border Grid.Column="2" CornerRadius="4" Padding="5,1" Background="{DynamicResource Bg.Pressed}" VerticalAlignment="Center">
                        <TextBlock Text="Esc" FontSize="10.5" Classes="muted" />
                    </Border>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" />
                <TextBlock DockPanel.Dock="Top" Text="No matching tools or actions." Classes="muted" FontSize="13" Margin="16,14"
                           IsVisible="{Binding HasNoPaletteResults}" />
                <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding PaletteSelection}"
                         MaxHeight="420" Background="Transparent" Margin="6" Tapped="OnPaletteItemTapped">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="10,7" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PaletteItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontSize="11.5" Classes="muted" Margin="12,0"
                                           IsVisible="{Binding HasShortcut}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Group}" FontSize="11.5" Classes="muted" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Border>
    </Panel>
</Window>
